{
  "manifest_version": 2,
  "id": "github.ling-cay.cayrememberyou",
  "version": "3.9.0",
  "name": "CAYRememberYou（跨群记忆）",
  "description": "让麦麦记得你在其他群聊里说过的话，并在合适时机自然提起。默认纯本地关键词检索，不消耗任何 Token；向量语义为可选开关，开启后才会产生 embedding 费用。",
  "author": {
    "name": "LING",
    "url": "https://github.com/Ling-CAY"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/Ling-CAY/PROJECT-CAY",
    "issues": "https://github.com/Ling-CAY/PROJECT-CAY/issues"
  },
  "host_application": {
    "min_version": "1.3.6",
    "max_version": "1.4.99"
  },
  "sdk": {
    "min_version": "2.9.0",
    "max_version": "2.21.99"
  },
  "dependencies": [],
  "plugin_type": "data",
  "capabilities": [
    "send.text",
    "llm.embed"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "locales_path": "i18n",
    "supported_locales": [
      "zh-CN",
      "en-US"
    ]
  },
  "display": {
    "icon": {
      "type": "local",
      "value": "icon.png",
      "fallback": "database"
    }
  }
}
